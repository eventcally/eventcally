[importlinter]
root_package = project
include_external_packages=True

[importlinter:contract:my-layers-contract]
name = My layers contract
type = layers
layers =
    project.presentation
    project.infrastructure
    project.application
    project.domain

[importlinter:contract:delivery-reads-through-queries]
name = Delivery layers and template/access helpers read through queries, not ORM models
type = forbidden
source_modules =
    project.presentation.web
    project.presentation.api
    project.presentation.shared
forbidden_modules =
    project.infrastructure.models
# Indirect chains stay allowed: every module reaches the models through project.container
# (-> infrastructure) and the remaining write-side services. Tried False in S11: 220+ chains.
allow_indirect_imports = True
# Ratchet baseline: only ever delete entries (python .scripts/models_import_ignores.py).
# Unmatched entries fail lint-imports, so a removed import forces removing its entry.
unmatched_ignore_imports_alerting = error
ignore_imports =
    project.presentation.web.views.flask_admin -> project.infrastructure.models
    project.presentation.web.views.flask_admin -> project.infrastructure.models.admin_unit
    project.presentation.web.views.flask_admin -> project.infrastructure.models.event_place
    project.presentation.web.views.flask_admin -> project.infrastructure.models.user

[importlinter:contract:shared-is-a-leaf]
name = Cross-layer helpers in project.shared depend on nothing above the domain
type = forbidden
source_modules =
    project.shared
forbidden_modules =
    project.application
    project.infrastructure
    project.presentation

[importlinter:contract:web-does-not-import-api]
name = The web channel does not import the API channel
type = forbidden
source_modules =
    project.presentation.web
forbidden_modules =
    project.presentation.api
allow_indirect_imports = True
# The custom-widget JSON endpoint deliberately serves the API representation.
ignore_imports =
    project.presentation.web.views.js -> project.presentation.api.custom_widget.schemas

[importlinter:contract:api-does-not-import-web]
name = The API channel does not import the web channel
type = forbidden
source_modules =
    project.presentation.api
forbidden_modules =
    project.presentation.web
allow_indirect_imports = True

[importlinter:contract:presentation-shared-is-channel-neutral]
name = presentation.shared imports neither channel
type = forbidden
source_modules =
    project.presentation.shared
forbidden_modules =
    project.presentation.web
    project.presentation.api
allow_indirect_imports = True
