[importlinter]
root_package = project
include_external_packages=True

[importlinter:contract:my-layers-contract]
name = My layers contract
type = layers
layers =
    project.infrastructure
    project.application
    project.domain
ignore_imports =
  project -> project.**

[importlinter:contract:delivery-reads-through-queries]
name = Delivery layers and template/access helpers read through queries, not ORM models
type = forbidden
source_modules =
    project.views
    project.api
    project.access
    project.jinja_filters
forbidden_modules =
    project.infrastructure.models
# Indirect chains stay allowed: every module reaches the models through project.container
# (-> infrastructure) and the remaining write-side services. Tried False in S11: 220+ chains.
allow_indirect_imports = True
# Ratchet baseline: only ever delete entries (python .scripts/models_import_ignores.py).
# Unmatched entries fail lint-imports, so a removed import forces removing its entry.
unmatched_ignore_imports_alerting = error
ignore_imports =
    project.views.flask_admin -> project.infrastructure.models
    project.views.flask_admin -> project.infrastructure.models.admin_unit
    project.views.flask_admin -> project.infrastructure.models.event_place
    project.views.flask_admin -> project.infrastructure.models.user
