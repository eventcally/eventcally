{
  "name": "eventcally-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n && vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "i18n": "tsx scripts/po2json.ts",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@floating-ui/vue": "2.0.1",
    "@fullcalendar/bootstrap5": "7.1.3",
    "@fullcalendar/vue3": "7.1.3",
    "@internationalized/date": "3.12.4",
    "@vueuse/core": "15.0.0",
    "@vueuse/integrations": "15.0.0",
    "bootstrap": "5.3.8",
    "bootstrap-vue-next": "1.2.2",
    "cropperjs": "1.6.2",
    "focus-trap": "8.2.3",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "openapi-fetch": "0.17.0",
    "reka-ui": "2.10.5",
    "temporal-polyfill": "1.0.6",
    "vue": "3.5.43",
    "vue-i18n": "11.4.2",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@types/gettext-parser": "9.0.0",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "gettext-parser": "9.1.1",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
