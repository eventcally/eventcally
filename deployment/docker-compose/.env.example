POSTGRES_BACKUP_PATH=./tmp/data/postgres/backups
FLUENTD_LOG_PATH=./tmp/logs/fluentd
FLUENTD_CUSTOM_CONFIG_PATH=./tmp/config
FLUENTD_DOCKER_CONTAINERS_PATH=/var/lib/docker/containers
# Compose project whose container logs fluentd collects (default: the compose file's name).
FLUENTD_COMPOSE_PROJECT=eventcally
NGINX_CONFIG_PATH=./tmp/config

POSTGRES_USER=eventcally
POSTGRES_PASSWORD=
POSTGRES_DB=eventcally
REDIS_PASSWORD=
LIMITER_REDIS_PASSWORD=

WEB_TAG=latest
SERVER_NAME=
PREFERRED_URL_SCHEME=https
# Behind an outer proxy (Plesk), bind to 127.0.0.1 so clients cannot bypass it.
HTTP_BIND=0.0.0.0
HTTP_PORT=5000
SECRET_KEY=
SECURITY_PASSWORD_HASH=
MAIL_SERVER=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_USE_TLS=True
GOOGLE_MAPS_API_KEY=
JWT_PRIVATE_KEY=""
JWT_PUBLIC_JWKS=''
DOCS_URL=''
ADMIN_UNIT_CREATE_REQUIRES_ADMIN=False
API_READ_ANONYM=False
# App, Celery and gunicorn log lines: json (fluentd reads their level) or console.
LOG_FORMAT=json
# One record per API request, collected by fluentd into FLUENTD_LOG_PATH/api-usage.*
# (needs LOG_FORMAT=json)
API_USAGE_LOG=True
# Days the API usage files are kept (fluentd deletes older ones hourly).
API_USAGE_LOG_RETENTION_DAYS=90
# Rotation interval of the API usage file; e.g. 60 (seconds) to check a staging setup quickly.
API_USAGE_LOG_TIMEKEY=1d
# Proxies that append to X-Forwarded-For: 1 = the bundled nginx, 2 = behind Plesk.
PROXY_FIX_X_FOR=1