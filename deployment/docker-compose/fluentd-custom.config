# Tail docker logs
<source>
  @type tail
  @label @DOCKER
  read_from_head true
  path /fluentd/containers/*/*-json.log
  pos_file /fluentd/log/docker.pos
  time_format %Y-%m-%dT%H:%M:%S
  tag docker.*
  format json
</source>

<label @DOCKER>
  # The tail reads all containers of the host: keep only this compose project's lines
  # (docker adds the project label as "attrs", see x-logging in docker-compose.yml)
  <filter docker.**>
    @type grep
    <regexp>
      key $['attrs']['com.docker.compose.project']
      pattern "/^#{ENV['FLUENTD_COMPOSE_PROJECT'] || 'eventcally'}$/"
    </regexp>
  </filter>

  # Add container id, drop the label again
  <filter docker.fluentd.containers.*.*.log>
    @type record_transformer
    remove_keys attrs
    <record>
      container_id ${tag_parts[3]}
    </record>
  </filter>

  # JSON lines (app with LOG_FORMAT=json, API usage records) become fields; other lines
  # (nginx, PostgreSQL, Redis, LOG_FORMAT=console) keep their raw "log" field.
  <filter docker.**>
    @type parser
    key_name log
    reserve_data true
    # keep docker's time of the line (also picks the usage file's day)
    reserve_time true
    remove_key_name_field true
    emit_invalid_record_to_error false
    <parse>
      @type json
    </parse>
  </filter>

  # The same input feeds the error log and the API usage log
  <match docker.**>
    @type copy

    <store>
      @type relabel
      @label @ERRORS
    </store>

    <store>
      @type relabel
      @label @API_USAGE
    </store>
  </match>
</label>

<label @ERRORS>
  # Errors and worse. JSON lines by their level (API usage records have level error
  # with a 5xx status). Raw lines by their text: [ERROR]/[CRITICAL] (LOG_FORMAT=console),
  # nginx [error]/[crit]/[alert]/[emerg], PostgreSQL FATAL:/PANIC:.
  <filter docker.**>
    @type grep
    <or>
      <regexp>
        key level
        pattern /^(error|critical)$/i
      </regexp>
      <regexp>
        key log
        pattern /\[(error|critical|crit|alert|emerg)\]|\| error \||\b(fatal|panic):/i
      </regexp>
    </or>
  </filter>

  <match docker.**>
    @type copy

    # Write errors to file
    <store>
      @type file
      path /fluentd/log/docker-error
    </store>

    # Count daily errors
    <store>
      @type relabel
      @label @ERROR_COUNT
    </store>
  </match>
</label>

<label @ERROR_COUNT>
  # API usage records stay in the error file but are not counted: an exception already
  # counts with its own line (same request_id)
  <filter docker.**>
    @type grep
    <exclude>
      key type
      pattern /^api_usage$/
    </exclude>
  </filter>

  # The count's message: the raw line, else the JSON line's event
  <filter docker.**>
    @type record_transformer
    enable_ruby true
    <record>
      message ${record["log"] || record["event"]}
    </record>
  </filter>

  <match docker.**>
    @type grepcounter
    count_interval 86400 # = 24 hours
    input_key message
    threshold 1
    add_tag_prefix daily_error
    delimiter \n
  </match>

  # Send daily error mail (grepcounter emits inside this label)
  #<match daily_error.docker.**>
  #  @type mail
  #  host [Host]
  #  port [Port]
  #  user [User/Email]
  #  password [Password]
  #  from [User/Email]
  #  to [Recipient]
  #  subject 'Error alert fluentd'
  #  message Error occured %s times, %s
  #  message_out_keys count, message
  #</match>
</label>

<label @API_USAGE>
  # One record per API request, written by the web app (logger eventcally.api_usage;
  # JSON only with LOG_FORMAT=json)
  <filter docker.**>
    @type grep
    <regexp>
      key type
      pattern /^api_usage$/
    </regexp>
  </filter>

  # The record's own fields (event and logger only repeat the type), plus the container
  # id and the project
  <filter docker.**>
    @type record_transformer
    remove_keys stream,event,logger
    <record>
      project "#{ENV['FLUENTD_COMPOSE_PROJECT'] || 'eventcally'}"
    </record>
  </filter>

  # One gzip file per day: api-usage.YYYYMMDD.log.gz
  <match docker.**>
    @type file
    path /fluentd/log/api-usage
    append true
    compress gzip
    <format>
      @type json
    </format>
    <buffer time>
      @type file
      path /fluentd/log/buffer/api-usage
      timekey "#{ENV['API_USAGE_LOG_TIMEKEY'] || '1d'}"
      timekey_wait 1m
      timekey_use_utc true
      flush_at_shutdown true
    </buffer>
  </match>
</label>

# Retention: delete API usage files older than API_USAGE_LOG_RETENTION_DAYS (default 90),
# hourly (in_exec first runs one interval after start). The command prints nothing.
<source>
  @type exec
  @label @HOUSEKEEPING
  tag housekeeping.api_usage
  command "find /fluentd/log -maxdepth 1 -type f -name 'api-usage.*' -mtime +#{[(ENV['API_USAGE_LOG_RETENTION_DAYS'] || '90').to_i - 1, 0].max} -delete"
  run_interval 1h
  <parse>
    @type none
  </parse>
</source>

<label @HOUSEKEEPING>
  <match **>
    @type null
  </match>
</label>
